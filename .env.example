SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-browser-safe-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PIN=choose-a-strong-pin
# Comma-separated Supabase Auth user UUIDs allowed to open Fero's private founder dashboard.
# This is server-only: never prefix it with VITE_ or expose it in browser code.
FOUNDER_DASHBOARD_USER_IDS=
# Required by Vercel Cron. Use a long, random secret; it is never sent to the browser.
CRON_SECRET=
ENABLE_SETTLEMENT_CONFIRMATIONS=false
ENABLE_SETTLEMENT_CONFIRMATIONS_PREVIEW=false
ENABLE_LOCAL_PREVIEW_AUTH=false
ENABLE_LOCAL_DEV_OTP=false
LOCAL_DEV_OTP_CODE=000000
